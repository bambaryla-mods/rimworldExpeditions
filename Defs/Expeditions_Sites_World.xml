			<li><category>Apparel</category><count>2~4</count></li>
			<li><thing>Silver</thing><count>200~500</count></li>
			<li><thing>MedicineIndustrial</thing><count>2~6</count></li>
		</loot>
		<daysOnSite>0.5</daysOnSite>
		<openness>1</openness>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef ParentName="Exp_SiteHarshNoCaptors" MayRequire="Ludeon.RimWorld.Odyssey">
		<defName>Exp_AlphaThrumbo</defName>
		<label>alpha thrumbo</label>
		<description>An alpha thrumbo has been seen grazing nearby. Bringing it down takes a tracker and a lot of guns.</description>
		<color>(0.6, 0.7, 0.85)</color>
		<link>
			<questRoots>
				<li>OpportunitySite_AlphaThrumbo_Giver</li>
			</questRoots>
			<retaliation><source>Manhunters</source></retaliation>
		</link>
		<findChanceBase>1</findChanceBase>
		<challenges>
			<li><challenge>Exp_SearchGame</challenge><weight>1.5</weight><requirement>100</requirement></li>
			<li><challenge>Exp_Fight</challenge><weight>2</weight><requirement>300</requirement></li>
			<li><challenge>Exp_Haul</challenge><weight>1</weight><requirement>200</requirement></li>
