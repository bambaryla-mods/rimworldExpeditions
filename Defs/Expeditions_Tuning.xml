<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<Expeditions.ExpeditionTuningDef>
		<defName>Expeditions_Tuning</defName>
		<label>expeditions tuning</label>

		<!-- squad score / requirement -> chance for one challenge -->
		<challengeRatioCurve>
			<points>
				<li>(0, 0)</li>
				<li>(0.5, 0.2)</li>
				<li>(1, 0.6)</li>
				<li>(1.5, 0.85)</li>
				<li>(2, 0.95)</li>
			</points>
		</challengeRatioCurve>

		<!-- prospecting: chance of a lead = techLevelCurve(tech level) x valueCurve(market value).
		     Tech levels: Undefined 0, Animal 1, Neolithic 2, Medieval 3, Industrial 4, Spacer 5, Ultra 6, Archotech 7 -->
		<techLevelCurve>
			<points>
				<li>(0, 1)</li>
				<li>(4, 0.8)</li>
				<li>(5, 0.45)</li>
				<li>(6, 0.2)</li>
				<li>(7, 0.05)</li>
			</points>
		</techLevelCurve>
		<valueCurve>
			<points>
				<li>(0, 1)</li>
				<li>(50, 0.85)</li>
				<li>(500, 0.55)</li>
				<li>(2000, 0.3)</li>
				<li>(10000, 0.1)</li>
			</points>
		</valueCurve>

