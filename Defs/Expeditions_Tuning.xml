<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<Expeditions.ExpeditionTuningDef>
		<defName>Expeditions_Tuning</defName>
		<label>expeditions tuning</label>

		<!-- share of non-success rolls that come out Partial instead of Failure -->
		<partialBand>0.3</partialBand>

		<!-- squad score / requirement -> chance for one challenge -->
		<challengeRatioCurve>
			<points>
				<li>(0, 0)</li>
				<li>(0.5, 0.2)</li>
				<li>(1, 0.6)</li>
				<li>(1.5, 0.85)</li>
				<li>(2, 0.95)</li>
			</points>
		</challengeRatioCurve>

		<!-- prospecting: chance of a lead = techLevelCurve(tech level) x valueCurve(market value).
		     Tech levels: Undefined 0, Animal 1, Neolithic 2, Medieval 3, Industrial 4, Spacer 5, Ultra 6, Archotech 7 -->
		<techLevelCurve>
			<points>
				<li>(0, 1)</li>
				<li>(4, 0.8)</li>
				<li>(5, 0.45)</li>
				<li>(6, 0.2)</li>
				<li>(7, 0.05)</li>
			</points>
		</techLevelCurve>
		<valueCurve>
			<points>
				<li>(0, 1)</li>
				<li>(50, 0.85)</li>
				<li>(500, 0.55)</li>
				<li>(2000, 0.3)</li>
				<li>(10000, 0.1)</li>
			</points>
		</valueCurve>

		<!-- Ideology work sites: the most of each stash item a squad brings back (Partial halves it) -->
		<worksiteShare>0.6</worksiteShare>
		<!-- squad Fight score asked per guard at a work site (100 is one decent fighter), at least 100 in all -->
		<worksiteFightPerGuard>90</worksiteFightPerGuard>

		<!-- Who can go. A CommRecruiter hiree goes only if the contract outlasts the trip by this many days. -->
		<contractMarginDays>1</contractMarginDays>
		<!-- a slave's suppression (0-1) -> chance of running away when the expedition resolves -->
		<slaveRunawayCurve>
			<points>
				<li>(0, 0.4)</li>
				<li>(0.5, 0.15)</li>
				<li>(1, 0.03)</li>
			</points>
		</slaveRunawayCurve>

		<!-- Fights on the road (turned creepjoiners, caught hirees). Enemy strength is in Fight score (100 is one decent fighter). -->
		<turnedCreepjoinerFactor>1.5</turnedCreepjoinerFactor>
		<fleshbeastFight>150</fleshbeastFight>
		<!-- share of the colony's threat points a sightstealer pack gets (vanilla rolls 0.25-0.65) -->
		<sightstealerPointsFactor>0.45</sightstealerPointsFactor>
		<!-- hostile hirees slip away when their Stealth score beats this, through challengeRatioCurve -->
		<slipAwayRequirement>100</slipAwayRequirement>
		<!-- squad Fight score / enemy strength -> chance the squad wins -->
		<fightWinCurve>
			<points>
				<li>(0.5, 0.15)</li>
				<li>(1, 0.5)</li>
				<li>(2, 0.85)</li>
				<li>(3, 0.97)</li>
			</points>
		</fightWinCurve>
		<!-- same ratio -> wound severity (0-1) for each squad member -->
		<fightWoundCurve>
			<points>
				<li>(0.5, 0.9)</li>
				<li>(1, 0.6)</li>
				<li>(3, 0.1)</li>
			</points>
		</fightWoundCurve>
		<!-- same ratio -> chance each squad member dies -->
		<fightDeathCurve>
			<points>
				<li>(0.5, 0.4)</li>
				<li>(1, 0.15)</li>
				<li>(3, 0)</li>
			</points>
		</fightDeathCurve>

		<biomeColors>
			<li><biome>TemperateForest</biome><color>(0.36, 0.48, 0.27)</color></li>
			<li><biome>BorealForest</biome><color>(0.30, 0.42, 0.30)</color></li>
			<li><biome>TropicalRainforest</biome><color>(0.22, 0.42, 0.20)</color></li>
			<li><biome>AridShrubland</biome><color>(0.66, 0.62, 0.40)</color></li>
			<li><biome>Desert</biome><color>(0.82, 0.72, 0.49)</color></li>
			<li><biome>ExtremeDesert</biome><color>(0.88, 0.78, 0.55)</color></li>
			<li><biome>Tundra</biome><color>(0.60, 0.64, 0.55)</color></li>
			<li><biome>IceSheet</biome><color>(0.92, 0.94, 0.96)</color></li>
			<li><biome>SeaIce</biome><color>(0.80, 0.86, 0.90)</color></li>
			<li><biome>ColdBog</biome><color>(0.40, 0.45, 0.38)</color></li>
			<li><biome>TemperateSwamp</biome><color>(0.35, 0.42, 0.30)</color></li>
			<li><biome>TropicalSwamp</biome><color>(0.30, 0.40, 0.25)</color></li>
			<li><biome>Ocean</biome><color>(0.16, 0.29, 0.39)</color></li>
			<li><biome>Lake</biome><color>(0.20, 0.35, 0.45)</color></li>
			<li MayRequire="Ludeon.RimWorld.Odyssey"><biome>Grasslands</biome><color>(0.55, 0.62, 0.33)</color></li>
			<li MayRequire="Ludeon.RimWorld.Odyssey"><biome>GlacialPlain</biome><color>(0.80, 0.85, 0.86)</color></li>
			<li MayRequire="Ludeon.RimWorld.Odyssey"><biome>Glowforest</biome><color>(0.25, 0.40, 0.45)</color></li>
			<li MayRequire="Ludeon.RimWorld.Odyssey"><biome>Scarlands</biome><color>(0.45, 0.33, 0.28)</color></li>
			<li MayRequire="Ludeon.RimWorld.Odyssey"><biome>LavaField</biome><color>(0.30, 0.20, 0.18)</color></li>
		</biomeColors>
	</Expeditions.ExpeditionTuningDef>

</Defs>
