<?xml version="1.0" encoding="utf-8"?>
<!-- Points of interest. "requirement" is the squad score a challenge asks for: 100 is one decent pawn on a Min, Max
     or Average challenge; Sum challenges (fight, haul) add up, so 300 is about three decent fighters.
     All numbers are starting points for tuning. -->
<Defs>

	<Expeditions.ExpeditionSiteDef Name="Exp_SiteBase" Abstract="True">
		<color>(0.85, 0.7, 0.35)</color>
	</Expeditions.ExpeditionSiteDef>

	<!-- Risk families. Every fate is written out: an unwritten "unharmed" defaults to 1.
	     No captors: mechs, insects and beasts don't take prisoners, so capture becomes death. -->

	<Expeditions.ExpeditionSiteDef Name="Exp_SiteGentle" ParentName="Exp_SiteBase" Abstract="True">
		<risk>
			<success><unharmed>0.95</unharmed><injured>0.05</injured><killed>0</killed><captured>0</captured></success>
			<partial><unharmed>0.8</unharmed><injured>0.2</injured><killed>0</killed><captured>0</captured></partial>
			<failure><unharmed>0.5</unharmed><injured>0.45</injured><killed>0.05</killed><captured>0</captured></failure>
		</risk>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef Name="Exp_SiteNoCaptors" ParentName="Exp_SiteBase" Abstract="True">
		<risk>
			<success><unharmed>0.8</unharmed><injured>0.2</injured><killed>0</killed><captured>0</captured></success>
			<partial><unharmed>0.5</unharmed><injured>0.4</injured><killed>0.1</killed><captured>0</captured></partial>
			<failure><unharmed>0.1</unharmed><injured>0.5</injured><killed>0.4</killed><captured>0</captured></failure>
		</risk>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef Name="Exp_SiteHarsh" ParentName="Exp_SiteBase" Abstract="True">
		<risk>
			<success><unharmed>0.8</unharmed><injured>0.2</injured><killed>0</killed><captured>0</captured></success>
			<partial><unharmed>0.5</unharmed><injured>0.4</injured><killed>0.14</killed><captured>0.06</captured></partial>
			<failure><unharmed>0.1</unharmed><injured>0.5</injured><killed>0.4</killed><captured>0.4</captured></failure>
		</risk>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef Name="Exp_SiteHarshNoCaptors" ParentName="Exp_SiteBase" Abstract="True">
		<risk>
			<success><unharmed>0.8</unharmed><injured>0.2</injured><killed>0</killed><captured>0</captured></success>
			<partial><unharmed>0.5</unharmed><injured>0.4</injured><killed>0.2</killed><captured>0</captured></partial>
			<failure><unharmed>0.1</unharmed><injured>0.5</injured><killed>0.8</killed><captured>0</captured></failure>
		</risk>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef ParentName="Exp_SiteBase">
		<defName>Exp_AbandonedMine</defName>
		<label>abandoned mine</label>
		<description>Old shafts cut into the hills. Whoever worked them left in a hurry.</description>
		<hilliness>
			<li>LargeHills</li>
			<li>Mountainous</li>
		</hilliness>
		<challenges>
			<li><challenge>Exp_SearchOre</challenge><weight>2</weight><requirement>100</requirement></li>
			<li><challenge>Exp_Endure</challenge><weight>1</weight><requirement>100</requirement></li>
			<li><challenge>Exp_Haul</challenge><weight>1.5</weight><requirement>200</requirement></li>
			<li><challenge>Exp_Fight</challenge><weight>0.5</weight><requirement>100</requirement></li>
		</challenges>
		<loot>
			<li><thing>Steel</thing><count>60~150</count></li>
			<li><thing>Plasteel</thing><count>10~40</count><chance>0.5</chance></li>
			<li><thing>Uranium</thing><count>10~30</count><chance>0.3</chance></li>
			<li><thing>Gold</thing><count>5~20</count><chance>0.3</chance></li>
			<li><thing>Silver</thing><count>40~120</count><chance>0.5</chance></li>
			<li><thing>ComponentIndustrial</thing><count>1~3</count><chance>0.3</chance></li>
		</loot>
		<servesCategories>
			<li>ResourcesRaw</li>
			<li>StoneChunks</li>
		</servesCategories>
		<daysOnSite>1</daysOnSite>
		<openness>0.3</openness>
		<squadSize>1~5</squadSize>
	</Expeditions.ExpeditionSiteDef>

	<!-- Ideology work sites: offered only for a real work site on the world map (see WorksiteLink). The Fight
	     requirement here is only for the debug evaluator; each offer sets it from the site's guards. Loot is the
	     site's own stash, cut to worksiteShare in Expeditions_Tuning. -->
	<Expeditions.ExpeditionSiteDef ParentName="Exp_SiteHarsh" MayRequire="Ludeon.RimWorld.Ideology">
		<defName>Exp_WorkSite</defName>
		<label>work site</label>
		<description>Another faction's camp, out working the land. Its guards stand over a stash; a squad can bring back at most 60% of it.</description>
		<color>(0.8, 0.33, 0.24)</color>
		<worksiteOnly>true</worksiteOnly>
		<findChanceBase>1</findChanceBase>
		<challenges>
			<li><challenge>Exp_Fight</challenge><weight>2</weight><requirement>300</requirement></li>
			<li><challenge>Exp_Stealth</challenge><weight>1.5</weight><requirement>100</requirement></li>
			<li><challenge>Exp_Haul</challenge><weight>1</weight><requirement>150</requirement></li>
		</challenges>
		<daysOnSite>0.5</daysOnSite>
		<openness>1</openness>
		<squadSize>1~6</squadSize>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef ParentName="Exp_SiteBase">
		<defName>Exp_CrashedShip</defName>
		<label>crashed ship</label>
		<description>A hull half buried where it came down. Some of it still hums.</description>
		<color>(0.85, 0.6, 0.25)</color>
		<challenges>
			<li><challenge>Exp_SearchSalvage</challenge><weight>2</weight><requirement>100</requirement></li>
			<li><challenge>Exp_Endure</challenge><weight>1</weight><requirement>100</requirement></li>
			<li><challenge>Exp_Haul</challenge><weight>1</weight><requirement>150</requirement></li>
		</challenges>
		<loot>
			<li><thing>ComponentIndustrial</thing><count>2~6</count></li>
			<li><thing>ComponentSpacer</thing><count>1~3</count><chance>0.4</chance></li>
			<li><thing>Plasteel</thing><count>20~60</count></li>
			<li><category>WeaponsRanged</category><count>1~2</count><chance>0.3</chance></li>
		</loot>
		<servesCategories>
			<li>Manufactured</li>
			<li>Weapons</li>
		</servesCategories>
		<daysOnSite>1</daysOnSite>
		<openness>0.6</openness>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef ParentName="Exp_SiteBase">
		<defName>Exp_HostileOutpost</defName>
		<label>hostile outpost</label>
		<description>A forward camp of a faction that wants you dead. Their stores are well stocked.</description>
		<color>(0.8, 0.33, 0.24)</color>
		<needsFaction>Hostile</needsFaction>
		<challenges>
			<li><challenge>Exp_Fight</challenge><weight>2</weight><requirement>300</requirement></li>
			<li><challenge>Exp_Stealth</challenge><weight>1.5</weight><requirement>100</requirement></li>
			<li><challenge>Exp_Haul</challenge><weight>1</weight><requirement>150</requirement></li>
		</challenges>
		<loot>
			<li><category>WeaponsRanged</category><count>1~2</count></li>
			<li><category>WeaponsMelee</category><count>1</count><chance>0.5</chance></li>
			<li><category>Apparel</category><count>1~3</count></li>
			<li><thing>MedicineIndustrial</thing><count>2~6</count><chance>0.6</chance></li>
			<li><thing>Silver</thing><count>100~400</count></li>
		</loot>
		<servesCategories>
			<li>Weapons</li>
			<li>Apparel</li>
		</servesCategories>
		<risk>
			<success><unharmed>0.8</unharmed><injured>0.2</injured></success>
			<partial><unharmed>0.5</unharmed><injured>0.4</injured><killed>0.14</killed><captured>0.06</captured></partial>
			<failure><unharmed>0.1</unharmed><injured>0.5</injured><killed>0.4</killed><captured>0.4</captured></failure>
		</risk>
		<daysOnSite>0.5</daysOnSite>
		<openness>1</openness>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef ParentName="Exp_SiteBase">
		<defName>Exp_GameHerd</defName>
		<label>game herd</label>
		<description>A big herd grazing out in the open, far from anyone else's hunters.</description>
		<color>(0.5, 0.69, 0.41)</color>
		<biomes>
			<li>TemperateForest</li>
			<li>BorealForest</li>
			<li>AridShrubland</li>
			<li>Tundra</li>
			<li MayRequire="Ludeon.RimWorld.Odyssey">Grasslands</li>
		</biomes>
		<challenges>
			<li><challenge>Exp_SearchGame</challenge><weight>2</weight><requirement>100</requirement></li>
			<li><challenge>Exp_Haul</challenge><weight>2</weight><requirement>200</requirement></li>
			<li><challenge>Exp_Fight</challenge><weight>0.5</weight><requirement>100</requirement></li>
		</challenges>
		<loot>
			<li><category>MeatRaw</category><count>60~200</count></li>
			<li><category>Leathers</category><count>30~100</count></li>
		</loot>
		<servesCategories>
			<li>MeatRaw</li>
			<li>Leathers</li>
		</servesCategories>
		<daysOnSite>1</daysOnSite>
		<openness>1</openness>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef ParentName="Exp_SiteBase">
		<defName>Exp_StalledConvoy</defName>
		<label>stalled convoy</label>
		<description>Wagons broken down on the road, the drivers long gone. The cargo is still aboard.</description>
		<color>(0.5, 0.69, 0.41)</color>
		<needsRoad>true</needsRoad>
		<challenges>
			<li><challenge>Exp_SearchSalvage</challenge><weight>1</weight><requirement>80</requirement></li>
			<li><challenge>Exp_Haul</challenge><weight>2</weight><requirement>200</requirement></li>
			<li><challenge>Exp_Fight</challenge><weight>0.5</weight><requirement>100</requirement></li>
		</challenges>
		<loot>
			<li><category>Textiles</category><count>40~120</count></li>
			<li><category>Foods</category><count>20~60</count></li>
			<li><thing>MedicineIndustrial</thing><count>2~5</count><chance>0.5</chance></li>
		</loot>
		<servesCategories>
			<li>Textiles</li>
			<li>Foods</li>
			<li>Medicine</li>
		</servesCategories>
		<openness>0.9</openness>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef ParentName="Exp_SiteBase">
		<defName>Exp_RiverCache</defName>
		<label>river cache</label>
		<description>A smuggler's cache sunk along the riverbank.</description>
		<needsRiver>true</needsRiver>
		<challenges>
			<li><challenge>Exp_SearchSalvage</challenge><weight>1.5</weight><requirement>100</requirement></li>
			<li><challenge>Exp_Endure</challenge><weight>1</weight><requirement>100</requirement></li>
		</challenges>
		<loot>
			<li><category>Drugs</category><count>3~10</count></li>
			<li><thing>Silver</thing><count>50~200</count></li>
			<li><thing>ComponentIndustrial</thing><count>1~3</count><chance>0.5</chance></li>
		</loot>
		<servesCategories>
			<li>Drugs</li>
		</servesCategories>
		<openness>0.5</openness>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef ParentName="Exp_SiteBase">
		<defName>Exp_FriendlyJob</defName>
		<label>job for an ally</label>
		<description>An allied faction needs hands for a dangerous errand. They pay in silver and gratitude.</description>
		<color>(0.35, 0.66, 0.85)</color>
		<needsFaction>Ally</needsFaction>
		<challenges>
			<li><challenge>Exp_Fight</challenge><weight>1.5</weight><requirement>200</requirement></li>
			<li><challenge>Exp_Endure</challenge><weight>1</weight><requirement>100</requirement></li>
		</challenges>
		<goodwillReward>8</goodwillReward>
		<silverReward>400</silverReward>
		<squadSize>2~6</squadSize>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef ParentName="Exp_SiteBase">
		<defName>Exp_HoldingCamp</defName>
		<label>holding camp</label>
		<description>Where they keep their captives. Storm it, or slip in and out with your people.</description>
		<color>(0.54, 0.36, 0.85)</color>
		<rescueOnly>true</rescueOnly>
		<challenges>
			<li><challenge>Exp_Fight</challenge><weight>1.5</weight><requirement>250</requirement></li>
			<li><challenge>Exp_Stealth</challenge><weight>1.5</weight><requirement>100</requirement></li>
		</challenges>
		<findChanceBase>0.9</findChanceBase>
		<risk>
			<success><unharmed>0.8</unharmed><injured>0.2</injured></success>
			<partial><unharmed>0.5</unharmed><injured>0.4</injured><killed>0.14</killed><captured>0.06</captured></partial>
			<failure><unharmed>0.1</unharmed><injured>0.5</injured><killed>0.4</killed><captured>0.4</captured></failure>
		</risk>
	</Expeditions.ExpeditionSiteDef>

	<Expeditions.ExpeditionSiteDef ParentName="Exp_SiteBase">
		<defName>Exp_Rumor</defName>
		<label>rumored stash</label>
		<description>Somebody heard from somebody that it is out here. Maybe.</description>
		<fallback>true</fallback>
		<challenges>
			<li><challenge>Exp_SearchSalvage</challenge><weight>1</weight><requirement>100</requirement></li>
			<li><challenge>Exp_Endure</challenge><weight>1</weight><requirement>100</requirement></li>
			<li><challenge>Exp_Fight</challenge><weight>1</weight><requirement>150</requirement></li>
		</challenges>
		<findChanceBase>0.5</findChanceBase>
	</Expeditions.ExpeditionSiteDef>

</Defs>
