<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Expeditions</RootNamespace>
		<AssemblyName>Expeditions</AssemblyName>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<OutputPath>..\1.7\Assemblies\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Optimize>true</Optimize>
		<DebugType>portable</DebugType>
		<RimWorldDir>$(MSBuildThisFileDirectory)..\..\..</RimWorldDir>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="obj/**" />
		<Compile Remove="Tests/**" />
		<Compile Remove="UIRethemedCompat/**" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Lib.Harmony" Version="2.4.3" ExcludeAssets="runtime" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
